<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Contract Monthly Claims </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ContractMonthlyClaimsSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 bg-dark">
                <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-white min-vh-100">
                    <a href="/" class="d-flex align-items-center pb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                        <div class="text-center">
                            <span class="fs-5 d-none d-sm-inline">Contract Monthly Claim System</span>
                        </div>
                    </a>
                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">

                        @if (Context.Session.GetString("Role") == "Lecturer")
                        {
                            <li class="nav-item">
                                <a asp-controller="Lecturer" asp-action="Home" class="nav-link align-middle px-0 text-white">
                                    <i class="fs-4 bi bi-house-door-fill"></i> <span class="ms-1 d-none d-sm-inline">Home</span>
                                </a>
                            </li>
                            <li>
                                <a href="#submenu1" data-bs-toggle="collapse" class="nav-link px-0 align-middle text-white">
                                    <i class="fs-4 bi bi-person-fill"></i><span class="ms-1 d-none d-sm-inline">Lecturer</span>
                                </a>
                                <ul class="collapse show nav flex-column ms-1" id="submenu1" data-bs-parent="#menu">
                                    <li class="w-100">
                                        <a asp-controller="Lecturer" asp-action="SubmitClaim" class="nav-link px-0 text-white">Submit Claim</a>
                                    </li>
                                    <li>
                                        <a asp-controller="Lecturer" asp-action="TrackClaim" class="nav-link px-0 text-white">My Claims</a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else if (Context.Session.GetString("Role") == "Reviewer")
                        {
                            <li class="nav-item">
                                <a asp-controller="Reviewer" asp-action="Home" class="nav-link align-middle px-0 text-white">
                                    <i class="fs-4 bi bi-house-door-fill"></i> <span class="ms-1 d-none d-sm-inline">Home</span>
                                </a>
                            </li>
                            <li> 
                                <a href="#submenu2" data-bs-toggle="collapse" class="nav-link px-0 align-middle text-white">
                                    <i class="fs-4 bi bi-people-fill"></i><span class="ms-1 d-none d-sm-inline">Reviewer</span>
                                </a>
                                <ul class="collapse show nav flex-column ms-1" id="submenu2" data-bs-parent="#menu">
                                    <li class="w-100">
                                        <a asp-controller="Reviewer" asp-action="PendingClaims" class="nav-link px-0 text-white">Pending Claims</a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else if (Context.Session.GetString("Role") == "HR")
                        {
                            <li class="nav-item">
                                <a asp-controller="HR" asp-action="Home" class="nav-link align-middle px-0 text-white">
                                    <i class="fs-4 bi bi-house-door-fill"></i> <span class="ms-1 d-none d-sm-inline">Home</span>
                                </a>
                            </li>

                            <li>
                                <a href="#submenu3" data-bs-toggle="collapse" class="nav-link px-0 align-middle text-white">
                                    <i class="fs-4 bi bi-people-fill"></i><span class="ms-1 d-none d-sm-inline">IC Management</span>
                                </a>
                                <ul class="collapse show nav flex-column ms-1" id="submenu3" data-bs-parent="#menu">
                                    <li class="w-100">
                                        <a asp-controller="HR" asp-action="AllLecturers" class="nav-link px-0 text-white">View Lecturers</a>
                                    </li>
                                    <li class="w-100">
                                        <a asp-controller="HR" asp-action="AddLecturer" class="nav-link px-0 text-white">Add Lecturers</a>
                                    </li>
                                </ul>
                            </li>

                             <li>
                                <a href="#submenu5" data-bs-toggle="collapse" class="nav-link px-0 align-middle text-white">
                                        <i class="fs-4 bi bi-book-fill"></i><span class="ms-1 d-none d-sm-inline">Records</span>
                                </a>
                                <ul class="collapse show nav flex-column ms-1" id="submenu5" data-bs-parent="#menu">
                                    <li class="w-100">
                                        <a asp-controller="HR" asp-action="ClaimReports" class="nav-link px-0 text-white">All Finalised Claims</a>
                                    </li>
                                    <li class="w-100">
                                        <a asp-controller="HR" asp-action="Payroll" class="nav-link px-0 text-white">Payslips</a>
                                    </li>
                                </ul>
                            </li>
                           
                        }
                    </ul>
                    
                    <div class="mt-auto w-100 pb-3">
                        <a asp-controller="Home" asp-action="Index" class="nav-link px-0 text-white">
                            <i class="bi bi-arrow-left-circle"></i> Exit
                        </a>
                    </div>
                </div>
            </div>
            <div class="col py-3">
                @RenderBody()
            </div>
        </div>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

    @*making alerts fade away automatically*@
    <script>
        window.setTimeout(function (){
            $(".alert").fadeTo(200, 0).slideUp(500, function (){
                $(this).remove();
            });
        }, 5000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
