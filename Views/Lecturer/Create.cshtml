@model ContractMonthlyClaimsSystem.Models.Lecturer

<h1>Create lecturer</h1>
<div class="container">
    <form asp-action="Create" method="post">
        <div class="form-group">
            <label for="Name">Name</label>
            <input type="text" class="form-control" id="Name" name="Name" asp-for="Name" required>
        </div>

        <div class="form-group mt-3">
            <label for="Email">Email</label>
            <input type="text" class="form-control" id="Email" name="Email" asp-for="Email" required>
        </div>

        <button type="submit" class="btn btn-primary mt-4">Submit</button>
    </form>
</div>

@if (Model != null && !string.IsNullOrEmpty(Model.Name) && !string.IsNullOrEmpty(Model.Email))
{
    <h4>Added @Model.Name ---- @Model.Email</h4>
}
