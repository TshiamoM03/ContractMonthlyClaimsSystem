@model IEnumerable<ContractMonthlyClaimsSystem.Models.Lecturer>

<div class="text-center">
    <h1 class="display-3 text-dark"><strong>Current Independent Contractor Lecturers</strong></h1><br />
</div>

@if(TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<div class="mx-auto" style="width: 950px;">
    <div class="container">
        <div class="p-4">
            <table class="table table-hover text-dark">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lecturer in Model)
                    {
                        <tr>
                            <td>@lecturer.LecturerId</td>
                            <td>@lecturer.Name</td>
                            <td>@lecturer.Email</td>
                            <td>@lecturer.Phone</td>
                            <td>@lecturer.Address</td>
                            <td>
                                <a asp-controller="Hr" asp-action="EditLecturer" asp-route-lecturerId="@lecturer.LecturerId" class="btn btn-secondary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>