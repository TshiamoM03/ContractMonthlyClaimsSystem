@model ContractMonthlyClaimsSystem.Models.Lecturer

<div class="text-center">
    <h1 class="display-3 text-dark"><strong>Update Lecturer Information</strong></h1><br />
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<div class="mx-auto" style="width: 700px;">
    <div class="container">
        <form asp-controller="HR" asp-action="EditLecturer" method="post" class="p-4">
            <div class="mb-4">
                <label asp-for="Name" class="form-label">Name and Surname</label>
                <input type="text" asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label">Email</label>
                <input type="email" asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Phone" class="form-label">Phone</label>
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text">+27</span>
                    </div>
                    <input type="tel" asp-for="Phone" class="form-control" />
                </div>
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Address" class="form-label">Address</label>
                <input type="text" asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="LecturerId" />
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </form>
    </div>
</div>
